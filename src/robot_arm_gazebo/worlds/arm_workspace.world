<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="arm_workspace">

    <!-- Physics Engine Configuration -->
    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- Scene & Lighting -->
    <scene>
      <ambient>0.45 0.45 0.48 1.0</ambient>
      <background>0.75 0.82 0.90 1.0</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <light name="workspace_fill_light" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>1.5 -1.5 2.5 0 0 0</pose>
      <diffuse>0.55 0.55 0.58 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.4 -0.8</direction>
    </light>

    <!-- Ground Plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Workbench Table (top surface at z = 0.750 m) -->
    <model name="workbench_table">
      <static>true</static>
      <pose>0.25 0.0 0.0 0 0 0</pose>
      <link name="table_link">
        <!-- Tabletop -->
        <collision name="tabletop_collision">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry>
            <box>
              <size>1.30 1.10 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="tabletop_visual">
          <pose>0 0 0.725 0 0 0</pose>
          <geometry>
            <box>
              <size>1.30 1.10 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.52 0.36 0.22 1</ambient>
            <diffuse>0.62 0.44 0.28 1</diffuse>
            <specular>0.12 0.12 0.12 1</specular>
          </material>
        </visual>

        <!-- Leg 1 -->
        <collision name="leg1_collision">
          <pose>-0.58 -0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
        </collision>
        <visual name="leg1_visual">
          <pose>-0.58 -0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.27 0.30 1</diffuse></material>
        </visual>

        <!-- Leg 2 -->
        <collision name="leg2_collision">
          <pose>0.58 -0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
        </collision>
        <visual name="leg2_visual">
          <pose>0.58 -0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.27 0.30 1</diffuse></material>
        </visual>

        <!-- Leg 3 -->
        <collision name="leg3_collision">
          <pose>-0.58 0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
        </collision>
        <visual name="leg3_visual">
          <pose>-0.58 0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.27 0.30 1</diffuse></material>
        </visual>

        <!-- Leg 4 -->
        <collision name="leg4_collision">
          <pose>0.58 0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
        </collision>
        <visual name="leg4_visual">
          <pose>0.58 0.48 0.35 0 0 0</pose>
          <geometry><box><size>0.06 0.06 0.70</size></box></geometry>
          <material><ambient>0.2 0.22 0.25 1</ambient><diffuse>0.25 0.27 0.30 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Graspable Test Cube 1 (Red, directly in front of robot) -->
    <model name="red_target_cube">
      <pose>0.30 0.00 0.769 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.2e-5</ixx><iyy>1.2e-5</iyy><izz>1.2e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.9 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Graspable Test Cube 2 (Blue, left side) -->
    <model name="blue_target_cube">
      <pose>0.28 0.16 0.769 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.2e-5</ixx><iyy>1.2e-5</iyy><izz>1.2e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.2 0.45 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Graspable Test Cube 3 (Green, right side) -->
    <model name="green_target_cube">
      <pose>0.28 -0.16 0.769 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.2e-5</ixx><iyy>1.2e-5</iyy><izz>1.2e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.036 0.036 0.036</size></box></geometry>
          <material><ambient>0.15 0.75 0.30 1</ambient><diffuse>0.2 0.85 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.10 -0.90 1.45 0 0.42 2.40</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
